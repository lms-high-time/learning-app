{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lms-high-time/learning-app/master/lms_frappe_app/agent_learning/catalog/catalog.public.schema.json",
  "title": "Каталог компетенций",
  "description": "Компетенции на все курсы: признаки уровней, классы по схемам классификации, связи «часть» и «похожа»; у схемы — закрытый список классов. Формат — CONTRACT.md, раздел «Каталог компетенций».",
  "type": "object",
  "required": ["format", "classifications", "competencies"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "lms-competency-catalog/1"},
    "classifications": {"type": "array", "items": {"$ref": "#/$defs/classification"}},
    "competencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/competency"}}
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "Постоянный ключ: не переименовывается и не переиспользуется."
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Уровень освоения: 1 — узнаёт, 2 — объясняет, 3 — применяет, 4 — переносит."
    },
    "level_text": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 140},
    "classification": {
      "type": "object",
      "description": "Схема классификации компетенций: закрытый список классов и первоисточник.",
      "required": ["key", "title", "source", "required", "classes"],
      "additionalProperties": false,
      "properties": {
        "key": {"$ref": "#/$defs/slug"},
        "title": {"$ref": "#/$defs/title"},
        "source": {
          "type": "array",
          "description": "Адреса первоисточника схемы; у своей схемы список пуст.",
          "items": {"type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 2000}
        },
        "required": {"type": "boolean", "description": "Класс в этой схеме обязателен каждой компетенции."},
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "title"],
            "additionalProperties": false,
            "properties": {
              "key": {"$ref": "#/$defs/slug"},
              "title": {"$ref": "#/$defs/title"}
            }
          }
        }
      }
    },
    "competency": {
      "type": "object",
      "required": ["key", "title", "description", "kind", "levels"],
      "additionalProperties": false,
      "properties": {
        "key": {"$ref": "#/$defs/slug"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "description": "Что человек делает, когда владеет умением."},
        "kind": {"enum": ["base", "integrative"]},
        "classes": {
          "type": "object",
          "description": "Класс компетенции в каждой схеме, где она классифицирована: ключ схемы → ключ класса из её списка.",
          "propertyNames": {"$ref": "#/$defs/slug"},
          "additionalProperties": {"$ref": "#/$defs/slug"}
        },
        "levels": {
          "type": "object",
          "description": "Признаки уровней 1–4 — один набор на все курсы, без курсового контекста.",
          "required": ["1", "2", "3", "4"],
          "additionalProperties": false,
          "properties": {
            "1": {"$ref": "#/$defs/level_text"},
            "2": {"$ref": "#/$defs/level_text"},
            "3": {"$ref": "#/$defs/level_text"},
            "4": {"$ref": "#/$defs/level_text"}
          }
        },
        "parts": {
          "type": "array",
          "description": "Составляющие интегративной компетенции; у базовой их нет.",
          "items": {
            "type": "object",
            "required": ["competency", "from_level"],
            "additionalProperties": false,
            "properties": {
              "competency": {"$ref": "#/$defs/slug"},
              "from_level": {"$ref": "#/$defs/level", "description": "С какого уровня интегративной нужна составляющая."}
            }
          }
        },
        "similar": {
          "type": "array",
          "description": "Компетенции про близкое умение.",
          "items": {"$ref": "#/$defs/slug"}
        }
      }
    }
  }
}
